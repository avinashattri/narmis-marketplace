# ====================================================================
# NARMIS SUPABASE ENVIRONMENT CONFIGURATION (Placeholders Only)
# Copy this file to .env for local development.
# Never commit actual credentials to Git.
#
# In Netlify, configure these exact variable names under:
#   Netlify Dashboard -> Site configuration -> Environment variables
# ====================================================================

# Your Supabase Project URL (e.g. https://svhadqhgkpaqevgafkhx.supabase.co)
VITE_SUPABASE_URL=https://your-project.supabase.co

# Your Supabase Publishable / Anon Key (from Supabase Dashboard -> Project Settings -> API Keys)
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: Payment UPI QR image path
VITE_PAYMENT_QR_URL=/payment-qr.jpg
