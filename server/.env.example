# ====================================================================
# NARMIS BACKEND ENVIRONMENT CONFIGURATION (Placeholders Only)
# Copy this file to server/.env and fill in your real credentials.
# Never commit server/.env to version control.
# ====================================================================

MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/narmis?retryWrites=true&w=majority
JWT_SECRET=replace_with_a_strong_64_char_random_hex_secret
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
FRONTEND_URL=http://localhost:5173
PORT=5000
